# Copy to .env. Nothing here is required for `npm start`.
# Without the keys below, the judge is the local checklist, X stays a draft,
# and QuickNode is idle. Devnet is still used when the program is deployed.

# Grok. https://console.x.ai/
XAI_API_KEY=
XAI_MODEL=grok-3

# X posting (OAuth 1.0a user context). https://developer.x.com/
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# X mention intake (app-only bearer). Recent search needs Basic access or higher.
X_BEARER_TOKEN=
X_BOT_HANDLE=holler
X_POLL_MS=45000

# Optional extra webhook that receives the same release payload as the X post.
GROK_BOT_WEBHOOK_URL=
HOLLER_ANNOUNCE=

# Shared secret for /api/hooks/x and /api/hooks/quicknode.
# Required before either URL is public.
HOLLER_HOOK_SECRET=
QUICKNODE_WEBHOOK_SECRET=

# Solana. Default cluster is devnet. Point this at a QuickNode devnet endpoint.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=
# Mainnet only. Devnet creates a 6-decimal demo mint on first boot.
USDC_MINT=
# Mainnet only. A JSON keypair array. The demo seed is refused on mainnet.
FEE_PAYER_KEYPAIR=

# Set to 1 to skip the network (tests do this).
HOLLER_SKIP_CHAIN=
HOLLER_SKIP_X=
